# Auth Service Configuration
API_ENV=development
JWT_SECRET=your-secure-jwt-secret-key
INTERNAL_SECRET=your-shared-internal-secret-key

# Database
DATABASE_URL=postgresql://auth_user:auth_pass@auth_postgres:5432/auth_db
# Redis
REDIS_URL=redis://auth_redis:6379/0

# Client Configuration
CLIENT_URL=http://localhost:3000
